# Copy to .env for local development. Never commit real values.
NODE_ENV=development

# Publishing is dry-run unless BOTH this is "live" AND the tenant has publishing_enabled = true.
PUBLISH_MODE=dry_run

# Postgres — app connects as the non-owner role so RLS applies.
DATABASE_URL=postgres://app_user:change-me@localhost:5432/jat_marketing_os
# Publisher: a login role that is a member of publisher_user (the only role that can read credentials).
# Leave empty to run export-only (no scheduling/publishing).
PUBLISHER_DATABASE_URL=postgres://jat_publisher:change-me@localhost:5432/jat_marketing_os
PUBLISHER_INTERVAL_SECONDS=30
MIGRATOR_DATABASE_URL=postgres://migrator:change-me@localhost:5432/jat_marketing_os

# Credential vault. In production use a KMS key (KEK_PROVIDER=aws-kms, KEK_ID=arn:...).
KEK_PROVIDER=local
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_KEK_BASE64=
LOCAL_KEK_ID=local-dev-1

# Anthropic (Phase 2)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_DRAFT=claude-sonnet-5-5
CLAUDE_MODEL_PLAN=claude-opus-5-5
CLAUDE_MODEL_QA=claude-haiku-5-5
DEFAULT_TENANT_MONTHLY_AI_BUDGET_CENTS=1500

# Facebook Pages publishing (Phase 4). Redirect URI to register in the Meta app: {BASE_URL}/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0

# More platforms. Register {BASE_URL}/oauth/{channel}/callback as each app's redirect URI
# (channel = linkedin, google_business_profile, threads, x). Unset → shown as "not configured".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202610
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_GRAPH_HOST=graph.threads.net
X_CLIENT_ID=
X_CLIENT_SECRET=

# Media platforms. Instagram uses the Facebook app above; YouTube uses the Google client above.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# api-sandbox.pinterest.com until Pinterest grants Standard access
PINTEREST_API_HOST=api.pinterest.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Media storage: Cloudflare R2 (private bucket; an API token scoped to it with Object Read & Write).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_JURISDICTION=eu
# Development alternative: a local folder (refused in production)
# LOCAL_MEDIA_DIR=./.media
# MEDIA_SIGNING_SECRET=   # 32 random bytes, base64
MAX_UPLOAD_MB=250
# Branded graphics need Playwright + Chromium installed
# GRAPHICS_RENDERER=chromium
